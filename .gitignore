# ==========================================
# VERIFICA LA PAZ - .gitignore
# Arquitectura: PythonAnywhere + SQLite Local + Uploads Locales
# ==========================================

# Base de datos SQLite (se crea automáticamente al iniciar la app)
*.db
*.sqlite3
*.sqlite
instance/

# Archivos subidos localmente (videos, audios, imágenes de proveedores)
backend/uploads/*
!backend/uploads/.gitkeep
*.mp4
*.mp3
*.wav
*.ogg

# Entornos virtuales de Python
venv/
env/
ENV/

# Variables de entorno y secretos (¡NUNCA subir!)
.env
.env.local
.env.production

# Archivos temporales y de caché
__pycache__/
*.py[cod]
*$py.class
*.log
.DS_Store
Thumbs.db

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
Profile

# Archivos de compilación y distribución
*.egg-info/
dist/
build/

# Scripts de desarrollo local (opcionales, no necesarios en producción)
*.bat